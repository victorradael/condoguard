# Modelo do .env do ambiente local. NÃO coloque segredos aqui.
#
# `make env` (ou o primeiro `make up`) copia este arquivo para .env e preenche
# cada variável marcada como [segredo] que estiver vazia com um valor aleatório.
# O .env fica fora do git. Para trocar um segredo, apague o valor no .env e rode
# `make env` de novo (Postgres só aplica senhas novas num volume vazio).

# ── Endereço público ─────────────────────────────────────────────────────────
# Nome que o Caddy atende com HTTPS. Para a PoC pelo túnel, o tráfego chega na
# porta interna :8080 e este valor não muda.
SITE_ADDRESS=localhost
# Origens aceitas pela API (separadas por vírgula). Inclua o domínio do túnel.
CORS_ALLOWED_ORIGINS=https://localhost

# Interface onde o Caddy publica 80/443. Use 127.0.0.1 para não expor na rede.
CADDY_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# Requisições por minuto por IP (geral e em /api/auth/*).
RATE_LIMIT_EVENTS=600
RATE_LIMIT_AUTH_EVENTS=20

# ── Portas só em 127.0.0.1 ───────────────────────────────────────────────────
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MAILPIT_UI_PORT=8025
MINIO_CONSOLE_PORT=9001

# ── Segredos (gerados por `make env`) ────────────────────────────────────────
# [segredo] superusuário do Postgres (administração e backup)
POSTGRES_SUPERUSER_PASSWORD=
# [segredo] dono do esquema, usado pelas migrações
POSTGRES_OWNER_PASSWORD=
# [segredo] papel da API em execução
POSTGRES_APP_PASSWORD=
# [segredo]
REDIS_PASSWORD=
# [segredo] chave HMAC dos JWT, em Base64
JWT_SECRET_KEY=
MINIO_ROOT_USER=condoguard-admin
# [segredo]
MINIO_ROOT_PASSWORD=
# Credencial da API no MinIO, com acesso só ao bucket abaixo.
S3_BUCKET=condoguard
S3_ACCESS_KEY=condoguard-api
# [segredo]
S3_SECRET_KEY=

# ── E-mail ───────────────────────────────────────────────────────────────────
MAIL_FROM=Condoguard <nao-responda@condoguard.local>

# ── Ferramentas ──────────────────────────────────────────────────────────────
# Pasta dos backups no host.
BACKUP_DIR=./backups
# Conta usada pelo k6 (uma das contas de teste do seed). Vazio: o roteiro cria
# uma conta descartável via /auth/register.
K6_EMAIL=
K6_PASSWORD=
